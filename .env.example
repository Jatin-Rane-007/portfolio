# Contact form transport (app/api/contact/route.ts).
# Copy to .env.local for dev; set the same names in Vercel project env vars.
# Until RESEND_API_KEY exists, /api/contact answers 503 and the form falls back
# to opening the visitor's own mail client — the site never dead-ends.

# resend.com → API Keys → Create. Free tier is 3,000 emails a month, 100 a day.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives enquiries. Defaults to the address in data/portfolio.ts.
# While on the test sender below, Resend only delivers to the email registered
# on the Resend account, so this has to match it.
# CONTACT_TO=007rjatin@gmail.com

# Envelope sender. onboarding@resend.dev is Resend's shared test address and
# shows "via resend.dev" in the mail client. After verifying your own domain in
# their dashboard, change this to a sender on that domain.
# CONTACT_FROM=Portfolio Contact <onboarding@resend.dev>

# Troubleshooting only: when set, a failed send returns the provider's rejection
# text in the response `hint` field as well as the server log. It names the
# account, so unset it in Vercel once you have read the reason.
# CONTACT_DEBUG=1
