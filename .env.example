# Contact form transport (app/api/contact/route.ts).
# Copy to .env.local for dev; set the same names in Vercel project env vars.
# Until SMTP_USER/SMTP_PASS exist, /api/contact answers 503 and the form falls
# back to opening the visitor's own mail client — the site never dead-ends.

# Gmail: smtp.gmail.com, port 465. Use a 16-char App Password, not your real
# password (Google account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=007rjatin@gmail.com
SMTP_PASS=potf mnrh avfn hmyh


# Inbox that receives enquiries. Defaults to the address in data/portfolio.ts.
# CONTACT_TO=007rjatin@gmail.com

# Envelope sender. Gmail rejects a From that is not the authenticated account,
# so leave this unset unless you have configured a "send as" alias. Visitors
# still land in Reply-To, so a reply goes straight back to them.
# CONTACT_FROM=you@example.com

# Troubleshooting only: when set, a failed send returns Gmail's rejection text
# in the response `hint` field as well as the server log. It names the account,
# so unset it in Vercel once you have read the reason.
# CONTACT_DEBUG=1
